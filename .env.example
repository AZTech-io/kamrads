# ---- KAMRADS settings: copy to .env and fill in ----

# Dashboard login (always set a password)
DASH_USER=aaron
DASH_PASS=change-me
# More people, each with their own watchlist, bids and alerts: name:password,name:password
DASH_USERS=matthew:change-me-too
DASHBOARD_URL=https://kamrads.example.com.au

# Buyer accounts - live bids may only show when logged in
PICKLES_EMAIL=
PICKLES_PASSWORD=
MANHEIM_EMAIL=
MANHEIM_PASSWORD=

# Phone alerts: install the free "ntfy" app, subscribe to a hard-to-guess topic, put the same topic here
NTFY_URL=https://ntfy.sh/kamrads-CHANGE-THIS-xxxxxx

# Optional: market research. Easier: paste the key under Settings on the dashboard instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
RESEARCH_PER_DAY=60

# Alert rules
ALERT_MINUTES=10          # alert in the final N minutes
SLEEPER_RATIO=0.25        # bid at or under 25% of the estimate = SLEEPER
CHEAP_VEHICLE_MAX=3000    # no estimate yet: any vehicle still under this = CHEAP
PENNY_MAX=5
INCLUDE_STATUTORY=false   # statutory write-offs can never be re-registered

# Sites (true/false)
PICKLES_ENABLED=true
MANHEIM_ENABLED=true
ALLBIDS_ENABLED=true
LLOYDS_ENABLED=true
GRAYS_ENABLED=true
SLATTERY_ENABLED=true
AUCTIONBARN_ENABLED=true
LLOYDS_MAX_AUCTIONS=20     # soonest-closing Lloyds auctions scanned each pass

# Polling
DISCOVERY_EVERY_MIN=10
HOT_EVERY_SEC=30
HOT_WINDOW_MIN=15
HOT_MAX_BID=25000

# Only if a site blocks the server: an Australian proxy, e.g. http://user:pass@host:port
PROXY_URL=                # every site
MANHEIM_PROXY_URL=        # Manheim only (it blocks US servers) - keeps paid proxy data small

# Home bases for distance and transport costs (each person picks theirs in Settings)
HOME_BASES=Karnup WA:-32.369,115.857|Canberra ACT:-35.281,149.129
# Rough costs - change to match your carriers and the sites' current terms
TRANSPORT_PICKUP_KM=80
TRANSPORT_VEHICLE_BASE=250
TRANSPORT_VEHICLE_PER_KM=0.35
TRANSPORT_HEAVY_FACTOR=2.2
PICKLES_FEES=1000:110,5000:275,15000:440,*:660   # price limit:fee, ...
MANHEIM_FEES=1000:110,5000:275,15000:440,*:660
ALLBIDS_PREMIUM=15
LLOYDS_PREMIUM=16.5
GRAYS_PREMIUM=16.5

# Morning digest (each person can change it in Settings)
DIGEST_HOUR=7
DIGEST_TZ=Australia/Sydney

# Daily database copies kept in data/backups
BACKUP_KEEP=14

# Your dashboard domain for HTTPS (docker compose --profile https up -d)
DOMAIN=

# Cloudflare Tunnel token (see README step 5)
CF_TUNNEL_TOKEN=
